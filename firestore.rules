rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getMembership(orgId) {
      let membershipId = orgId + "_" + request.auth.uid;
      let ref = /databases/$(database)/documents/organizationMembers/$(membershipId);
      return exists(ref) ? get(ref).data : null;
    }

    function hasActiveMembership(orgId) {
      let m = getMembership(orgId);
      return m != null && m.status == "active";
    }

    function isOwner(orgId) {
      let m = getMembership(orgId);
      return m != null && m.status == "active" && m.role == "owner";
    }

    function isAdminOrOwner(orgId) {
      let m = getMembership(orgId);
      return m != null && m.status == "active" && (m.role == "admin" || m.role == "owner");
    }

    function checkParentOrg(parentCollection, parentId, orgId) {
      let pRef = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      return exists(pRef) && get(pRef).data.organizationId == orgId;
    }

    function isParentActive(parentCollection, parentId) {
      let pRef = /databases/$(database)/documents/$(parentCollection)/$(parentId);
      return get(pRef).data.isActive == true;
    }

    // ─── Organizations ───
    match /organizations/{orgId} {
      allow read: if hasActiveMembership(orgId);
      // Organization documents carry no `id` field (the doc ID is the org ID),
      // so updates are gated on ownership alone.
      allow update: if isOwner(orgId);

      // Organization creation is a batched write: org + owner membership
      allow create: if isAuthenticated() &&
                    !exists(/databases/$(database)/documents/organizations/$(orgId)) &&
                    getAfter(/databases/$(database)/documents/organizationMembers/$(orgId + "_" + request.auth.uid)).data.role == "owner" &&
                    getAfter(/databases/$(database)/documents/organizationMembers/$(orgId + "_" + request.auth.uid)).data.status == "active" &&
                    getAfter(/databases/$(database)/documents/organizationMembers/$(orgId + "_" + request.auth.uid)).data.organizationId == orgId;
    }

    // ─── Organization Memberships ───
    match /organizationMembers/{membershipId} {
      allow get: if resource.data.userId == request.auth.uid || hasActiveMembership(resource.data.organizationId);
      allow list: if resource.data.userId == request.auth.uid;
      allow list: if hasActiveMembership(resource.data.organizationId);
      allow update: if isOwner(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       request.resource.data.userId == resource.data.userId;

      allow create: if isAuthenticated() &&
                    membershipId == request.resource.data.organizationId + "_" + request.resource.data.userId &&
                    (
                      isOwner(request.resource.data.organizationId) 
                      ||
                      (
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.role == "owner" &&
                        request.resource.data.status == "active" &&
                        !exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
                        existsAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
                      )
                    );
    }

    // ─── Buildings ───
    match /buildings/{buildingId} {
      allow read: if hasActiveMembership(resource.data.organizationId);
      allow create: if isAdminOrOwner(request.resource.data.organizationId);
      allow update: if isAdminOrOwner(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAdminOrOwner(resource.data.organizationId);
    }

    // ─── Floors ───
    match /floors/{floorId} {
      allow read: if hasActiveMembership(resource.data.organizationId);
      allow create: if isAdminOrOwner(request.resource.data.organizationId) &&
                    request.resource.data.keys().hasAll(["buildingId", "organizationId"]) &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId) &&
                    isParentActive("buildings", request.resource.data.buildingId);
      allow update: if isAdminOrOwner(resource.data.organizationId) &&
                    request.resource.data.organizationId == resource.data.organizationId &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId);
      allow delete: if isAdminOrOwner(resource.data.organizationId);
    }

    // ─── Rooms ───
    match /rooms/{roomId} {
      allow read: if hasActiveMembership(resource.data.organizationId);
      allow create: if isAdminOrOwner(request.resource.data.organizationId) &&
                    request.resource.data.keys().hasAll(["buildingId", "floorId", "organizationId"]) &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId) &&
                    isParentActive("buildings", request.resource.data.buildingId) &&
                    checkParentOrg("floors", request.resource.data.floorId, request.resource.data.organizationId) &&
                    isParentActive("floors", request.resource.data.floorId);
      allow update: if isAdminOrOwner(resource.data.organizationId) &&
                    request.resource.data.organizationId == resource.data.organizationId &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId) &&
                    checkParentOrg("floors", request.resource.data.floorId, request.resource.data.organizationId);
      allow delete: if isAdminOrOwner(resource.data.organizationId);
    }

    // ─── Beds ───
    match /beds/{bedId} {
      allow read: if hasActiveMembership(resource.data.organizationId);
      allow create: if isAdminOrOwner(request.resource.data.organizationId) &&
                    request.resource.data.keys().hasAll(["buildingId", "floorId", "roomId", "organizationId"]) &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId) &&
                    isParentActive("buildings", request.resource.data.buildingId) &&
                    checkParentOrg("floors", request.resource.data.floorId, request.resource.data.organizationId) &&
                    isParentActive("floors", request.resource.data.floorId) &&
                    checkParentOrg("rooms", request.resource.data.roomId, request.resource.data.organizationId) &&
                    isParentActive("rooms", request.resource.data.roomId);
      allow update: if isAdminOrOwner(resource.data.organizationId) &&
                    request.resource.data.organizationId == resource.data.organizationId &&
                    checkParentOrg("buildings", request.resource.data.buildingId, request.resource.data.organizationId) &&
                    checkParentOrg("floors", request.resource.data.floorId, request.resource.data.organizationId) &&
                    checkParentOrg("rooms", request.resource.data.roomId, request.resource.data.organizationId);
      allow delete: if isAdminOrOwner(resource.data.organizationId);
    }

    // ─── Default deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}