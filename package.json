{
  "name": "pg-manager",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @pg-manager/mobile",
    "android": "npm run android -w @pg-manager/mobile",
    "api:dev": "npm run dev -w @pg-manager/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:rules": "firebase emulators:exec --only firestore --project pg-manager-rules-test \"npm run test:rules:run\"",
    "test:rules:run": "TS_NODE_PROJECT=tsconfig.rules.json TS_NODE_TRANSPILE_ONLY=true mocha -r ts-node/register firestore.rules.test.ts --timeout 30000 --exit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "firebase-admin": "^14.5.0",
    "mocha": "^12.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
